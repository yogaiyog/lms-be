# Dependencies
node_modules/
jspm_packages/
web_modules/

# Environment variables and secrets
.env
.env.local
.env.*.local
*.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Build and Compilation outputs (if using TypeScript/Babel)
build/
out/

# Testing and Coverage
coverage/
.nyc_output/

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db

# Database
*.db
*.db-journal

# Hasil build (dibuat oleh `npm run build` / CI)
dist/

# Backup database lokal (bisa berisi data user & hash password)
prisma/*.db.backup*

# Sertifikat/QR hasil generate runtime (berisi nama siswa)
generated/certificates/*
!generated/certificates/.gitkeep
