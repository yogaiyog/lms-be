datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                          String           @id @default(uuid())
  email                       String           @unique
  password                    String
  role                        String           @default("PARENT") // ADMIN | TUTOR | PARENT | STUDENT
  emailVerified               Boolean          @default(false)
  emailVerificationToken      String?          @unique
  emailVerificationTokenExpiresAt DateTime?
  passwordResetToken          String?          @unique
  passwordResetTokenExpiresAt DateTime?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
  parentProfile               ParentProfile?
  tutorProfile                TutorProfile?
  studentProfile              StudentProfile?
  refreshTokens               RefreshToken[]
}

model ParentProfile {
  id             String           @id @default(uuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  phone          String
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  students       StudentProfile[]
  requestClasses RequestClass[]
}

model TutorProfile {
  id            String          @id @default(uuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  phone         String
  bio           String?
  avatarUrl     String?
  meetLink      String?         // default meeting link for tutor
  dayoff1       Int?            // 0=Mon..6=Sun
  dayoff2       Int?            // 0=Mon..6=Sun
  classes       Class[] @relation("ClassTutors")
  announcements Announcement[]
  slots         TutorSlot[]
  savedReports  SavedReport[]
  requestClasses RequestClass[] @relation("PreferredTutor")
  attendance     Attendance[]
}

model StudentProfile {
  id            String         @id @default(uuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId      String
  parent        ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  fullName      String
  nickname      String
  birthDate     DateTime
  avatarUrl     String?
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])
  totalXp       Int            @default(0)
  currentStreak Int            @default(0)
  lastActive    DateTime?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  school        String?
  enrollments      Enrollment[]
  attendances      Attendance[]
  badgeLogs        StudentBadge[]
  requestClasses   RequestClass[]
  certificates     Certificate[]
  galleries        Gallery[]
  savedReports     SavedReport[]
  topicProgress    StudentTopicProgress[]
  quizAttempts     QuizAttempt[]
}

model Class {
  id               String         @id @default(uuid())
  name             String
  type             String         @default("BATCH") // BATCH | PRIVATE | MAKEUP | TRIAL
  categoryId       String?
  category         Category?      @relation(fields: [categoryId], references: [id])
  tutors           TutorProfile[] @relation("ClassTutors")
  curriculumId     String?
  curriculum       Curriculum?    @relation(fields: [curriculumId], references: [id])
  batch            Int
  startDate        DateTime
  isActive         Boolean        @default(true)
  isOnline         Boolean        @default(true)
  location         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  enrollments      Enrollment[]
  schedules        Schedule[]
  announcements    Announcement[]
  prevRequests     RequestClass[] @relation("PrevClass")
  approvedRequests RequestClass[] @relation("ApprovedClass")
}

model Enrollment {
  id                 String       @id @default(uuid())
  studentId          String
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId            String?
  class              Class?       @relation(fields: [classId], references: [id])
  curriculumId       String
  curriculum         Curriculum   @relation(fields: [curriculumId], references: [id])
  joinedAt           DateTime     @default(now())
  totalMeetPurchased Int          @default(0)
  totalMeetLeft      Int          @default(0)
  verified           Boolean      @default(false)
  meetUsages         MeetUsage[]

  @@unique([studentId, classId])
}

model MeetUsage {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  scheduleId   String
  schedule     Schedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  studentId    String
  attendanceId String     @unique
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  date         DateTime
  createdAt    DateTime   @default(now())
}

model Schedule {
  id          String      @id @default(uuid())
  classId     String
  class       Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  dayOfWeek   String      // MONDAY | TUESDAY | WEDNESDAY | THURSDAY | FRIDAY | SATURDAY | SUNDAY
  startTime   String
  endTime     String
  meetLink    String
  topic       String?
  topicId     String?
  topicRef    Topic?      @relation(fields: [topicId], references: [id])
  date        DateTime
  isDone      Boolean     @default(false)
  attendances Attendance[]
  meetUsages  MeetUsage[]
}

model TutorSlot {
  id          String        @id @default(uuid())
  tutorId     String
  tutor       TutorProfile  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  dayOfWeek   String        // MONDAY..SUNDAY
  startTime   String        // "09:00"
  endTime     String        // "10:00"
  createdAt   DateTime      @default(now())

  @@unique([tutorId, dayOfWeek, startTime])
}

model Attendance {
  id         String                @id @default(uuid())
  scheduleId String
  schedule   Schedule              @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  studentId  String
  student    StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime
  status     String                @default("PRESENT") // PRESENT | ABSENT | LATE | SICK | PERMISSION | RESCHEDULE
  notes      String?
  teachedBy  String?
  tutor      TutorProfile?         @relation(fields: [teachedBy], references: [id])
  assessment AttendanceAssessment?
  meetUsage  MeetUsage?
  createdAt  DateTime              @default(now())

  @@unique([scheduleId, studentId, date])
}

model Announcement {
  id        String       @id @default(uuid())
  classId   String
  class     Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  tutorId   String
  tutor     TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Curriculum {
  id              String              @id @default(uuid())
  name            String
  assessmentSetId String?
  assessmentSet   AssessmentSet?      @relation(fields: [assessmentSetId], references: [id])
  categories      CurriculumCategory[]
  topics          Topic[]
  classes         Class[]
  enrollments     Enrollment[]
  certificates    Certificate[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model CurriculumCategory {
  curriculumId  String
  curriculum    Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([curriculumId, categoryId])
}

model Category {
  id           String               @id @default(uuid())
  name         String               @unique // "Kelas 1", "Kelas 2", ...
  label        String               // "Kelas 1 SD", "Kelas 2 SD", ...
  curriculums  CurriculumCategory[]
  classes      Class[]
  students     StudentProfile[]
  createdAt    DateTime             @default(now())
}

model Certificate {
  id                String          @id @default(uuid())
  studentId         String
  student           StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  curriculumId      String
  curriculum        Curriculum      @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  certificateNumber String          @unique
  grade             String?
  filePath          String?
  issuedAt          DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([studentId])
  @@index([curriculumId])
}

model Gallery {
  id         String          @id @default(uuid())
  studentId  String
  student    StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  imageUrl   String
  caption    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([studentId])
}

model Topic {
  id                 String      @id @default(uuid())
  curriculumId       String?
  curriculum         Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  title              String
  imageUrl           String?
  materialLink       String?
  exampleProjectLink String?
  goals              String?
  tools              String?
  order              Int         @default(0)
  schedules          Schedule[]
  tasks             TopicTask[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Badge {
  id            String         @id @default(uuid())
  title         String
  description   String
  imageUrl      String
  xpBonus       Int            @default(0)
  studentBadges StudentBadge[]
}

model StudentBadge {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge          @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime       @default(now())

  @@unique([studentId, badgeId])
}

model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId      String
  tokenHash     String    @unique
  deviceId      String?
  deviceName    String?
  userAgent     String?
  ipAddress     String?
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model RequestClass {
  id               String         @id @default(uuid())
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId         String
  parent           ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  prevClassId      String?        // optional, untuk student yg sudah punya kelas aktif & ingin ganti jadwal
  prevClass        Class?         @relation("PrevClass", fields: [prevClassId], references: [id])
  category         String         // KIDS | JUNIOR_I | JUNIOR_II (denormalized)
  curriculum       String         // kurikulum yg diminta (e.g. "Scratch Adventurer")
  days             String         // JSON array of day strings: ["MONDAY","WEDNESDAY"]
  startTime        String         // "09:00"
  endTime          String         // "10:30"
  sessionCount     Int            @default(1) // 1 atau 2 (sesi per minggu)
  preferredTutorId String?
  preferredTutor   TutorProfile?  @relation("PreferredTutor", fields: [preferredTutorId], references: [id])
  notes            String?        // catatan dari parent/student
  status           String         @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  adminNotes       String?        // catatan admin
  approvedClassId  String?        // class yg diassign setelah approval
  approvedClass    Class?         @relation("ApprovedClass", fields: [approvedClassId], references: [id])
  reviewedBy       String?        // userId admin yg mereview
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// === ASSESSMENT / PENILAIAN ===

model AssessmentSet {
  id          String             @id @default(uuid())
  name        String
  description String?
  aspects     AssessmentAspect[]
  curriculums Curriculum[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model AssessmentAspect {
  id             String                    @id @default(uuid())
  assessmentSetId String
  assessmentSet  AssessmentSet            @relation(fields: [assessmentSetId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  icon           String?
  minScore       Int                      @default(1)
  maxScore       Int                      @default(5)
  order          Int                      @default(0)
  scores         AttendanceAssessmentScore[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model AttendanceAssessment {
  id            String                      @id @default(uuid())
  attendanceId  String                      @unique
  attendance    Attendance                  @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  totalScore    Int?
  percentage    Float?
  projectLink   String?
  mentorComment String?
  scores        AttendanceAssessmentScore[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
}

model AttendanceAssessmentScore {
  id           String              @id @default(uuid())
  assessmentId String
  assessment   AttendanceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  aspectId     String
  aspect       AssessmentAspect    @relation(fields: [aspectId], references: [id], onDelete: Cascade)
  score        Int
  notes        String?
  createdAt    DateTime            @default(now())

  @@unique([assessmentId, aspectId])
}

model Image {
  id         String   @id @default(uuid())
  url        String   @unique
  filename   String
  mimeType   String
  size       Int
  entityType String   // e.g. "avatar", "topic", "badge", "certificate", "announcement", "general"
  entityId   String?  // ID of the related entity (nullable for standalone uploads)
  uploadedBy String?  // userId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
}

model SavedReport {
  id        String          @id @default(uuid())
  tutorId   String
  tutor     TutorProfile    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  data      String          // JSON — full GeneratedReport snapshot
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// === SELF-PACED LEARNING (Scratch GUI roadmap integration) ===

enum TaskType {
  SCRATCH
  QUIZ
  PYTHON
}

model TopicTask {
  id            String                @id @default(uuid())
  topicId       String
  topic         Topic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type          TaskType              @default(SCRATCH)
  code          String                // "m1", "l1", "capstone-motion", ... = taskId from Scratch GUI
  label         String                // "1", "2", ... "Capstone"
  url           String?               // URL Scratch GUI per level
  order         Int                   @default(0)
  isCapstone    Boolean               @default(false)
  instructions  String?               // markdown instructions (for PYTHON type)
  defaultCode   String?               // default starter code (for PYTHON type)
  createdAt     DateTime              @default(now())

  quiz          Quiz?
  progress      StudentTopicProgress[]

  @@unique([topicId, code])
  @@index([topicId])
}

model Quiz {
  id          String         @id @default(uuid())
  taskId      String         @unique
  task        TopicTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
}

model QuizQuestion {
  id          String   @id @default(uuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question    String   @db.Text
  choices     Json     // [{ content: "blocks3...", isCorrect: boolean, feedback: "..." }]
  createdAt   DateTime @default(now())
}

model QuizAttempt {
  id          String   @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Int
  createdAt   DateTime @default(now())
}

model StudentTopicProgress {
  id           String        @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicTaskId  String
  topicTask    TopicTask     @relation(fields: [topicTaskId], references: [id], onDelete: Cascade)
  status       String        @default("available") // available | in_progress | completed
  metadata     String?       // JSON: { projectId, source, levelId }
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([studentId, topicTaskId])
  @@index([studentId])
}
